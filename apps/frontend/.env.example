# Build-time profile: browser-oidc, shared-identity or institution-bff. No automatic fallback.
# Supported pairs (Frontend + Backend LEDGER_AUTH_MODE):
# browser-oidc + caller-bearer; shared-identity + shared-identity; institution-bff + caller-bearer.
VITE_AUTH_MODE=browser-oidc

# Public app directory for canonical/Open Graph URLs; include a sub-path when deployed under one.
# Optional locally. Set to the actual public URL before building for link sharing.
# VITE_PUBLIC_URL=https://explorer.example/

# PUBLIC browser build configuration, never server credentials.
VITE_OIDC_ISSUER=http://localhost:8080/realms/explorer
VITE_OIDC_CLIENT_ID=explorer-browser
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPES=openid profile
# Optional provider-specific authorization request parameter (not token exchange).
# VITE_OIDC_AUDIENCE=https://canton.example

# For shared-identity, set VITE_AUTH_MODE=shared-identity and remove the VITE_OIDC_* lines.
# No Browser client ID, secret, token, login or individual identity is used in that profile.
# Configure the service credential ONLY in the Backend environment/secret manager.

# Vite dev/preview only: direct Backend API target for browser-oidc/shared-identity, no auth proxy.
# For institution-bff mode, set VITE_AUTH_MODE=institution-bff and point this to the existing auth front.
# Remove VITE_OIDC_* settings for institution-bff; no Browser client ID or secret is used.
# Pair only with Backend LEDGER_AUTH_MODE=caller-bearer (startup-time); keep SHARED_IDENTITY_* unset.
# Institution BFF integration: docs/deployment.md#institution-bff.
# All institution login/callback/logout paths require its gateway; Vite forwards API/OpenAPI only.
BACKEND_PROXY_TARGET=http://localhost:7600
