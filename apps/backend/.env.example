# Backend API. No defaults: missing values stop startup.
LEDGER_AUTH_MODE=caller-bearer
LEDGER_BASE=http://localhost:7575
API_PORT=7600
API_HOST=127.0.0.1
#BASE_PATH=/explorer
PUBLIC_ENTRY_URL=http://localhost:5173/

# Shared Identity profile: set LEDGER_AUTH_MODE=shared-identity and supply ALL four required
# values below at Backend startup. Keep these unset (not even empty) in caller-bearer mode.
# Server-only: NEVER copy these into apps/frontend/.env or VITE_* variables.
# SHARED_IDENTITY_ISSUER=https://idp.example/realms/explorer
# SHARED_IDENTITY_CLIENT_ID=explorer-service
# SHARED_IDENTITY_CLIENT_SECRET=replace-with-secret-from-secret-manager
# SHARED_IDENTITY_SCOPES=ledger.read
# Optional IdP-specific audience parameter; no resource or arbitrary grant parameters.
# SHARED_IDENTITY_AUDIENCE=https://canton.example
# HTTPS is required. For local development only, explicitly use an HTTP loopback issuer
# (e.g. http://localhost:8080/realms/explorer); only then is loopback HTTP Canton allowed too.
# A Backend in a container cannot use that exemption — inside a container a loopback name reaches
# the container itself — so it names the hosts whose plaintext HTTP it may use instead. Every host
# not named still requires HTTPS, and startup prints a warning naming the ones allowed. The IdP
# must also advertise the address it is reached at: Discovery's issuer claim is compared with
# SHARED_IDENTITY_ISSUER. Development only; see docs/deployment.md#docker.
# SHARED_IDENTITY_INSECURE_HTTP_HOSTS=host.docker.internal
# All users share one Lens. Protect the API with operator-managed access control.
