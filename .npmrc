; Dependency lifecycle scripts run arbitrary code merely by being installed. Block them by default,
; and when a package that really needs a build shows up, allow it by name at that time.
ignore-scripts=true

; Better to stop than to quietly run on a Node that violates engines.
engine-strict=true

; Do not install while the lockfile and package.json disagree.
; Dependencies are added by a person with `pnpm add`, and the lockfile is committed.
prefer-frozen-lockfile=true
