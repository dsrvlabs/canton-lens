# Docker deployment configuration. Copy this file and fill in your own values:
#
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
#   docker compose -f docker/compose.yaml up -d --build
#
# Compose reads docker/.env, which git ignores (.gitignore: .env*). docker/compose.yaml holds no
# values, so a deployment never edits a tracked file. apps/frontend/.env and apps/backend/.env are
# for local development and are not read here.
#
# Leave unused variables commented out rather than empty. An empty SHARED_IDENTITY_* value counts
# as present, and apps/backend/src/auth/config.ts then refuses to start in caller-bearer mode.
#
# VITE_* values are written into the browser bundle as literals and are delivered to every visitor:
# public build configuration, never a credential. Changing one needs `up -d --build`. Everything
# else is read by the Backend process at startup and needs only `up -d`.

# ── Where the Explorer is published ───────────────────────────────────────────────────────────
# The frontend container publishes this port. The default binds to loopback only: this deployment
# terminates no TLS and enforces no access control of its own. Put TLS, edge access control and
# rate limiting in front of it before widening EXPLORER_BIND (docs/security.md).
EXPLORER_PORT=8080
EXPLORER_BIND=127.0.0.1

# ── Authentication profile ────────────────────────────────────────────────────────────────────
# Supported pairs. A missing, invalid or mismatched mode fails at build or startup; there is no
# automatic fallback and no mode inference.
#
#   VITE_AUTH_MODE     LEDGER_AUTH_MODE   Canton credential
#   browser-oidc       caller-bearer      per-user token, held in browser memory
#   shared-identity    shared-identity    one shared service token, held by the Backend
#   institution-bff    caller-bearer      per-user token attached by the institution's own BFF
VITE_AUTH_MODE=browser-oidc
LEDGER_AUTH_MODE=caller-bearer

# ── Canton participant ────────────────────────────────────────────────────────────────────────
# The participant's JSON API base URL. There is no default: naming the wrong ledger silently is
# worse than refusing to start. shared-identity additionally requires HTTPS here, with explicit
# loopback HTTP allowed for local development only.
LEDGER_BASE=https://canton.example

# The Explorer's public entry address, used to recover from an expired caller token. It is the
# service entry, not a login route. Must match EXPLORER_BIND/EXPLORER_PORT as a browser sees them.
PUBLIC_ENTRY_URL=http://localhost:8080/

# Optional API sub-path, for a gateway that forwards a prefix without stripping it. Leaving it
# unset is correct for this compose file: docker/nginx.conf serves the Explorer at the root, and
# a prefix here would also need matching location blocks there.
#BASE_PATH=/explorer

# ── browser-oidc ──────────────────────────────────────────────────────────────────────────────
# Required when VITE_AUTH_MODE=browser-oidc; remove or comment out for the other profiles. The
# issuer must support OIDC Discovery, PKCE and browser CORS, and must issue an access token with
# the audience and claims Canton expects. Configure no client secret: this is a public client and
# every value below is visible in the bundle.
#
# Both redirect URIs must be query-free URLs in the same origin and directory as the Explorer
# itself, so they follow EXPLORER_PORT.
VITE_OIDC_ISSUER=https://idp.example/realms/explorer
VITE_OIDC_CLIENT_ID=explorer-browser
VITE_OIDC_REDIRECT_URI=http://localhost:8080/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/
VITE_OIDC_SCOPES=openid profile
# Optional provider-specific authorization request parameter. Not a token exchange.
#VITE_OIDC_AUDIENCE=https://canton.example

# ── shared-identity ───────────────────────────────────────────────────────────────────────────
# For VITE_AUTH_MODE=shared-identity with LEDGER_AUTH_MODE=shared-identity. Comment out the
# VITE_OIDC_* block above: that profile uses no browser client, login, or individual identity.
#
# These four are required together and are Backend-only. Never copy them into a VITE_* variable
# and never pass them as a build argument: a build argument is recorded in the history of the
# stage that declares it, printed in build output, and kept in the build cache. Read at startup,
# as here, the value stays out of every image.
#
# The Backend caches the issued token in process memory. After rotating the secret, issuer or
# scopes, restart every Backend instance; revoking a client secret may not revoke tokens already
# issued. This profile does not authenticate individual users: everyone who reaches the Explorer
# shares one Canton scope, so operator-managed access control in front of it is required.
#SHARED_IDENTITY_ISSUER=https://idp.example/realms/explorer
#SHARED_IDENTITY_CLIENT_ID=explorer-service
#SHARED_IDENTITY_CLIENT_SECRET=replace-with-secret-from-secret-manager
#SHARED_IDENTITY_SCOPES=ledger.read
# Optional IdP-specific audience parameter; no resource or arbitrary grant parameters.
#SHARED_IDENTITY_AUDIENCE=https://canton.example

# ── shared-identity against a local stack (development only) ──────────────────────────────────
# HTTPS is required above, with loopback addresses exempt. A container cannot use that exemption:
# inside a container `localhost` is the container itself, and the address that does reach the host
# is not a loopback name. Name the hosts whose plaintext HTTP the Backend may use. Every host not
# named still requires HTTPS, so a value left behind here cannot cover a production ledger, and
# startup prints a warning naming what was allowed.
#
# Two more conditions have to hold, and neither is about this file:
#  - The IdP must advertise the same address it is reached at. Discovery's `issuer` claim is
#    compared with SHARED_IDENTITY_ISSUER, so a Keycloak that answers on host.docker.internal while
#    advertising `localhost` is refused. Set the IdP's own hostname (Keycloak: KC_HOSTNAME).
#  - The ledger and the issuer must both be plaintext or both be TLS. One local stack, not a remote
#    IdP over TLS beside a ledger in the clear.
#SHARED_IDENTITY_INSECURE_HTTP_HOSTS=host.docker.internal
#LEDGER_BASE=http://host.docker.internal:7575
#SHARED_IDENTITY_ISSUER=http://host.docker.internal:8280/realms/explorer
