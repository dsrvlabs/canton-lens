{
  "name": "canton-lens",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Read-only explorer for a Canton participant's private ledger. Visibility is enforced by Canton, not by this app.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @canton-lens/frontend dev",
    "dev:backend": "pnpm --filter @canton-lens/backend dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "openapi:generate": "pnpm --filter @canton-lens/backend openapi:generate",
    "openapi:check": "pnpm --filter @canton-lens/backend openapi:check",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
